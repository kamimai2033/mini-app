# Exact PWA origin(s), comma-separated. No trailing path, wildcard, or credentials.
NEWS_ALLOWED_ORIGINS=https://daily.example.com
# FreshRSS admin URL reachable by the user through the household reverse proxy.
FRESHRSS_PUBLIC_URL=https://rss.example.com
NEWS_FRESHRSS_USER=news
# Default ports are reachable from the NAS itself only.
NEWS_BIND_ADDRESS=127.0.0.1
NEWS_API_PORT=8010
FRESHRSS_ADMIN_PORT=8088
