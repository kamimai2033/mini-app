{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mini-app/news/protocol-1/requests",
  "$defs": {
    "identity": {
      "type": "object",
      "required": ["operation_id", "server_id"],
      "properties": {
        "operation_id": {"type": "string", "format": "uuid"},
        "server_id": {"type": "string", "format": "uuid"}
      }
    },
    "operations": {
      "allOf": [{"$ref": "#/$defs/identity"}],
      "type": "object",
      "required": ["item_ids", "changes"],
      "properties": {
        "item_ids": {"type": "array", "minItems": 1, "maxItems": 500, "items": {"type": "string", "pattern": "^tag:google.com,2005:reader/item/[0-9a-fA-F]{1,32}$"}},
        "changes": {"type": "object", "minProperties": 1, "additionalProperties": false, "properties": {"read": {"type": "boolean"}, "starred": {"type": "boolean"}}}
      }
    },
    "feeds": {
      "allOf": [{"$ref": "#/$defs/identity"}],
      "type": "object",
      "required": ["action"],
      "properties": {
        "action": {"enum": ["add", "update", "pause", "resume"]},
        "feed_id": {"type": "string", "pattern": "^feed/[1-9][0-9]{0,15}$"},
        "url": {"type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048},
        "title": {"type": "string", "minLength": 1, "maxLength": 160},
        "category": {"enum": ["総合", "経済", "IT"]}
      },
      "if": {"properties": {"action": {"const": "add"}}},
      "then": {"required": ["url"]},
      "else": {"required": ["feed_id"], "not": {"required": ["url"]}}
    },
    "refresh": {"type": "object", "additionalProperties": false, "required": ["server_id"], "properties": {"server_id": {"type": "string", "format": "uuid"}}}
  },
  "oneOf": [{"$ref": "#/$defs/operations"}, {"$ref": "#/$defs/feeds"}, {"$ref": "#/$defs/refresh"}]
}
